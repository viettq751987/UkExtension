{
  "manifest_version": 3,
  "name": "UK Listing Optimizer",
  "version": "1.3.4",
  "description": "Scrape Amazon UK products \u2192 SEO rewrite \u2192 eBay UK package",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.amazon.co.uk/*",
    "https://openrouter.ai/*",
    "https://m.media-amazon.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.uk/dp/*",
        "https://www.amazon.co.uk/*/dp/*"
      ],
      "js": [
        "content_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.amazon.co.uk/dp/*",
        "https://www.amazon.co.uk/*/dp/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*.js",
        "icons/*.png"
      ],
      "matches": [
        "https://www.amazon.co.uk/*"
      ]
    }
  ]
}